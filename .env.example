# Unsolvable.ai — set these in Netlify → Project configuration → Environment variables
# (scope: Functions). Never commit real values. Total size of all variables must stay under ~4 KB.

# Required for uploads, provider links and the background worker. 32+ random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MEDIA_SIGNING_SECRET=

# Your email. This account gets the admin role at signup and can generate.
OWNER_EMAIL=

# Roles allowed to generate when credits are off (comma-separated).
GENERATION_ROLES=admin,creator

# ── Providers (add any you have; each unlocks its models) ──
RUNWAY_API_KEY=          # https://dev.runwayml.com — video (Gen-4.5, Aleph 2) and images (Gen-4 Image)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey — Veo 3.1 video + creative director
OPENAI_API_KEY=          # https://platform.openai.com/api-keys — GPT Image 2
ELEVENLABS_API_KEY=      # https://elevenlabs.io/app/settings/api-keys — voiceover
HIGGSFIELD_API_KEY=      # https://open.higgsfield.ai/api-keys — Seedance 2.0 (paste the full key)

# Creative director model overrides (optional)
DIRECTOR_GEMINI_MODEL=gemini-2.5-flash-lite
DIRECTOR_OPENAI_MODEL=gpt-5-mini

# Credits (optional, needs Netlify Database — see docs/DEPLOYMENT.md)
CREDITS_ENABLED=false
